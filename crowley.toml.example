# crowley — example configuration.
#
# Copy this file to `crowley.toml` (or anywhere else) and pass it with
# `-c <path>`. Every key is optional; values shown here are the defaults.
# CLI flags override the config file, which overrides these defaults.

# Path to the `crwl` binary (a bare name resolves through PATH).
crwl_bin = "crwl"

# Default `-o` output format for fetched content.
# all | json | markdown | md | markdown-fit | md-fit
output_format = "markdown"

# Default browser profile used by crwl (e.g. for pages behind a login).
# profile = "default"

# Paths to crwl browser/crawler config files (YAML/JSON), passed via -B/-C.
# browser_config = "/path/to/browser.yaml"
# crawler_config = "/path/to/crawler.yaml"

# Kill a crwl invocation after this many seconds.
timeout_secs = 60

# Cap tool responses at this many characters (overflow is truncated).
max_output_chars = 200000

# Default deep-crawl strategy: bfs | dfs | best-first.
# deep_crawl = "bfs"

# Default page cap for deep-crawl mode.
# max_pages = 10

# Extra raw arguments forwarded verbatim to every `crwl crawl` invocation.
# extra_args = ["--bypass-cache"]

# Identity reported in the MCP `initialize` handshake.
server_name = "crowley"
server_version = "0.1.0"

# Verbose logging (and crwl -v by default).
verbose = false

# ---------------------------------------------------------------------------
# Transport — MCP over stdio (default) or Streamable HTTP (port listening).
# ---------------------------------------------------------------------------

# stdio | http
transport = "stdio"

# Bind address and port for the http transport.
# port 0 binds an ephemeral port; the actual address is logged at startup.
host = "127.0.0.1"
port = 4321

# URL path the MCP Streamable HTTP endpoint is mounted at.
http_path = "/mcp"

# Allowed `Host` header values for the http transport (DNS-rebinding guard).
# Add any hostname clients use, e.g. "0.0.0.0" when binding all interfaces
# or a reverse-proxy host like "example.com:8080".
allowed_hosts = ["localhost", "127.0.0.1", "::1"]
